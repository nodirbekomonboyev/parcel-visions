# Qaysi provayder ishlatiladi: ollama (lokal, tekin) yoki claude (pullik, aniqroq)
VISION_PROVIDER=ollama

# --- Ollama (lokal) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=120

# --- Claude (ixtiyoriy) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Saqlash ---
DB_PATH=data/extractions.db

# Qo'lyozma aniqlansa shu burchaklarda qayta o'qiladi (bo'sh = o'chiq)
DESKEW_ANGLES=35,-35
